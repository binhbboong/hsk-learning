# Backend-only secrets and settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_SPEECH_VOICE=coral
OPENAI_TIMEOUT_SECONDS=15
OPENAI_DAILY_PATH_TIMEOUT_SECONDS=180
ALLOWED_ORIGINS=http://localhost:4200
# Production: PostgreSQL connection injected by Vercel Marketplace/Neon.
# Local/test can omit this and continue using backend/data/hsk_learning.sqlite3.
DATABASE_URL=

# Telegram reminder for one learning account. Create a bot with @BotFather,
# send it a message, then obtain the chat ID from getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ACCOUNT_EMAIL=
TELEGRAM_TIMEZONE=Asia/Ho_Chi_Minh
# GitHub Actions sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Frontend build setting (never put a secret here)
API_BASE_URL=http://localhost:8000
